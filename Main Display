<!DOCTYPE html>
<html>
    <head>
      <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
        <title>Latihan Markup</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 0;
                padding: 0;
                background-color: #f8f8f8;
            }

            header {
                background-color: #ff6600;
                padding: 30px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            header img {
                height: 50px;
            }

            #menu-utama {
                list-style: none;
                padding: 0;
                display: flex;
                flex-grow: 1;
                justify-content: center;
            }

            #menu-utama li {
                margin: 0 15px;
            }

            #menu-utama a {
                text-decoration: none;
                color: white;
                font-weight: bold;
            }
            form {
            position: relative;
            display: flex;
            align-items: center;
            }

            form input[type="text"] {
            padding: 10px 15px 10px 40px; /* Ruang ekstra untuk ikon di kiri */
            border-radius: 20px; /* Membuat sudut lebih bulat */
            border: 1px solid #ccc;
            width: 250px; /* Memperpanjang input */
            outline: none;
            }

            form .search-icon {
            position: absolute;
            left: 12px;
            font-size: 16px;
            color: #666;
            }

            #daftar-masakan {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                padding: 20px;
            }

            masakan {
                background: white;
                border-radius: 10px;
                box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
                margin: 20px;
                padding: 15px;
                width: calc(33.33% - 40px);
                text-align: center;
                transition: transform 0.3s ease-in-out;
            }

            masakan:hover {
                transform: scale(1.1);
            }

            masakan img {
                width: 100%;
                border-radius: 10px;
            }

            masakan h1 {
                font-size: 20px;
                color: #333;
            }

            masakan p {
                color: #666;
            }

            masakan a {
                display: inline-block;
                margin-top: 10px;
                padding: 8px 12px;
                background: #ff6600;
                color: white;
                text-decoration: none;
                border-radius: 5px;
            }

            /* Sidebar Styling */
            aside {
            position: fixed;
            top: 70px;
            right: -260px;
            width: 260px;
            height: calc(100% - 70px);
            background: linear-gradient(135deg, #ff7b00, #ff3d00);
            padding: 20px;
            box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
            transition: right 0.4s ease-in-out;
            color: white;
            border-radius: 10px 0 0 10px;
            }

            aside h2 {
            font-size: 18px;
            margin-bottom: 10px;
            text-transform: uppercase;
            border-bottom: 2px solid rgba(255, 255, 255, 0.5);
            padding-bottom: 5px;
            }

            aside p {
            font-size: 14px;
            line-height: 1.5;
            }

            aside ul {
            list-style: none;
            padding: 0;
            margin-top: 15px;
            }

            aside ul li {
            margin: 10px 0;
            }

            aside ul li a {
            text-decoration: none;
            color: white;
            display: block;
            padding: 10px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 5px;
            transition: background 0.3s ease-in-out;
            }

            aside ul li a:hover {
            background: rgba(255, 255, 255, 0.4);
            }

            #sidebar-trigger {
                position: fixed;
                top: 0;
                right: 0;
                width: 30px; 
                height: 100%;
                background: rgba(255, 102, 0, 0.2);
                cursor: pointer;
            }

            #sidebar-arrow {
                position: fixed;
                top: 50%;
                right: 10px;
                width: 40px;
                height: 40px;
                background: #ff6600;
                color: white;
                font-size: 24px;
                text-align: center;
                line-height: 40px;
                border-radius: 50%;
                cursor: pointer;
                transition: right 0.3s ease-in-out;
            }

            /* Animasi Sidebar */
            #sidebar-trigger:hover + aside,
            aside:hover {
                right: 0;
            }

            #sidebar-trigger:hover + aside #sidebar-arrow,
            aside:hover #sidebar-arrow {
                left: 10px;
}
        </style>
    </head>

